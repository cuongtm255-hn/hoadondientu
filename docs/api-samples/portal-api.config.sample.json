{
  "schemaVersion": 2,
  "verified": false,
  "notes": "Đối chiếu thật: đăng nhập, tra cứu bán ra (tdlap/tthai/ttxly/khmshdon/shdon/khhdon/unhiem/nmmst/nmcmnd) và mua vào (nbmst/nmcmnd, ttxly chỉ 5/6/8 và bắt buộc), xem chi tiết, xuất XML (zip), xuất Excel. CHƯA có mẫu thật: tra cứu mua vào khi bỏ ttxly, trang kế tiếp qua tham số state khi tổng > size, kích thước trang tối đa.",
  "baseUrl": "https://hoadondientu.gdt.gov.vn",
  "auth": {
    "authenticatePath": "/api/security-taxpayer/authenticate",
    "tokenResponsePath": "token",
    "headerName": "Authorization",
    "scheme": "Bearer",
    "sendCookies": true,
    "forwardHeaders": []
  },
  "http": {
    "timeoutSeconds": 60,
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36",
    "defaultHeaders": {
      "Accept": "application/json, text/plain, */*",
      "Accept-Language": "vi",
      "end-point": "/tra-cuu/tra-cuu-hoa-don",
      "Referer": "https://hoadondientu.gdt.gov.vn/tra-cuu/tra-cuu-hoa-don"
    },
    "requestIdHeader": "request-id",
    "actionHeader": "action"
  },
  "search": {
    "purchase": {
      "method": "GET",
      "path": "/api/query/invoices/purchase",
      "action": "Tìm kiếm (hóa đơn {direction})"
    },
    "sold": {
      "method": "GET",
      "path": "/api/query/invoices/sold",
      "action": "Tìm kiếm (hóa đơn {direction})"
    },
    "rsql": {
      "param": "search",
      "separator": ";",
      "dateField": "tdlap",
      "dateTimeFormat": "dd/MM/yyyy'T'HH:mm:ss",
      "proxyTrueValue": "1"
    },
    "fixedParameters": {
      "sort": "tdlap:desc"
    },
    "pagination": {
      "pageSizeParam": "size",
      "pageSize": 50,
      "cursorParam": "state"
    },
    "soldFilterFields": {
      "CounterpartyTaxCode": "nmmst",
      "BuyerIdNumber": "nmcmnd",
      "StatusCode": "tthai",
      "CheckResultCode": "ttxly",
      "InvoiceNumber": "shdon",
      "FormSymbol": "khmshdon",
      "InvoiceSymbol": "khhdon",
      "ProxyInvoice": "unhiem"
    },
    "purchaseFilterFields": {
      "CounterpartyTaxCode": "nbmst",
      "BuyerIdNumber": "nmcmnd",
      "StatusCode": "tthai",
      "CheckResultCode": "ttxly",
      "InvoiceNumber": "shdon",
      "FormSymbol": "khmshdon",
      "InvoiceSymbol": "khhdon",
      "ProxyInvoice": "unhiem"
    },
    "response": {
      "itemsPath": "datas",
      "totalPath": "total",
      "nextCursorPath": "state",
      "timeZoneOffsetHours": 7,
      "dateFormats": [
        "yyyy-MM-ddTHH:mm:ssZ",
        "yyyy-MM-ddTHH:mm:ss.fffZ",
        "yyyy-MM-ddTHH:mm:ss",
        "yyyy-MM-dd",
        "dd/MM/yyyy"
      ],
      "fields": {
        "PortalInvoiceId": "id",
        "FormSymbol": "khmshdon",
        "InvoiceSymbol": "khhdon",
        "InvoiceNumber": "shdon",
        "IssueDate": "tdlap",
        "SellerTaxCode": "nbmst",
        "SellerName": "nbten",
        "BuyerTaxCode": "nmmst",
        "BuyerIdNumber": "nmcmnd",
        "BuyerName": "nmten",
        "BuyerAddress": "nmdchi",
        "TotalBeforeTax": "tgtcthue",
        "TotalTax": "tgtthue",
        "TotalDiscount": "ttcktmai",
        "TotalFee": "tgtphi",
        "TotalPayment": "tgtttbso",
        "Currency": "dvtte",
        "ExchangeRate": "tgia",
        "StatusRaw": "tthai",
        "CheckResultRaw": "ttxly"
      }
    }
  },
  "detail": {
    "endpoint": {
      "method": "GET",
      "path": "/api/query/invoices/detail",
      "action": "Xem hóa đơn (hóa đơn {direction})"
    },
    "parameters": {
      "nbmst": "SellerTaxCode",
      "khhdon": "InvoiceSymbol",
      "shdon": "InvoiceNumber",
      "khmshdon": "FormSymbol"
    }
  },
  "download": {
    "endpoint": {
      "method": "GET",
      "path": "/api/query/invoices/export-xml",
      "action": "Xuất xml (hóa đơn {direction})"
    },
    "parameters": {
      "nbmst": "SellerTaxCode",
      "khhdon": "InvoiceSymbol",
      "shdon": "InvoiceNumber",
      "khmshdon": "FormSymbol"
    },
    "responseMode": "Zip",
    "zipEntryName": "invoice.xml",
    "fileNameTemplate": "{SellerTaxCode}_{InvoiceSymbol}_{InvoiceNumber}.xml"
  },
  "exportExcel": {
    "endpoint": {
      "method": "GET",
      "path": "/api/query/invoices/export-excel",
      "action": "Xuất hóa đơn (hóa đơn {direction})"
    }
  },
  "errors": {
    "statusKinds": {},
    "retryAfterHeader": "Retry-After"
  },
  "rateLimit": {
    "minIntervalMs": 3000
  }
}
